{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/api/tools/slug/:slug", "destination": "/api/tools/__slug__?slug=:slug" },
    { "source": "/api/tools/:id", "destination": "/api/tools/__id__?id=:id" },
    { "source": "/api/categories/slug/:slug", "destination": "/api/categories/__slug__?slug=:slug" },
    { "source": "/api/categories/:id", "destination": "/api/categories/__id__?id=:id" },
    { "source": "/api/articles/slug/:slug", "destination": "/api/articles/__slug__?slug=:slug" },
    { "source": "/api/articles/:id", "destination": "/api/articles/__id__?id=:id" },
    { "source": "/api/submissions/:id", "destination": "/api/submissions/__id__?id=:id" },
    { "source": "/api/ad-slots/:id", "destination": "/api/ad-slots/__id__?id=:id" },
    { "source": "/api/tools", "destination": "/api/tools/__root__" },
    { "source": "/api/categories", "destination": "/api/categories/__root__" },
    { "source": "/api/articles", "destination": "/api/articles/__root__" },
    { "source": "/api/submissions", "destination": "/api/submissions/__root__" },
    { "source": "/api/ad-slots", "destination": "/api/ad-slots/__root__" },
    { "source": "/tools", "destination": "/" },
    { "source": "/tools/:slug", "destination": "/" },
    { "source": "/categories", "destination": "/" },
    { "source": "/category/:slug", "destination": "/" },
    { "source": "/top-tools", "destination": "/" },
    { "source": "/submit", "destination": "/" },
    { "source": "/blog", "destination": "/" },
    { "source": "/blog/:slug", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/terms", "destination": "/" },
    { "source": "/404", "destination": "/" },
    { "source": "/admin/login", "destination": "/" },
    { "source": "/admin", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
