# ============================================================================
# Aivora — environment variable template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit real secrets.
# In production (Vercel) set these in the project's environment variables UI.
#
# This file (.env.example) is safe to commit: it contains only placeholders.
# ============================================================================

# --- Database (PostgreSQL / Supabase) --------------------------------------
# Runtime DB: Supabase connection POOLER (PgBouncer, transaction mode) on port 6543.
# Used by the running app. Supports serverless connection reuse.
# Note: URL-encode any special characters in the password (e.g. `/` → `%2F`).
# Note: statement_cache_size=0 avoids "prepared statement already exists" errors
# under Supabase's transaction-mode pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0&connection_limit=1"

# Direct DB: Supabase DIRECT connection on port 5432 (no pooler).
# Used ONLY by Prisma migrations (migrate deploy / migrate diff) and the
# one-time data-migration / admin-provisioning scripts. Not for runtime.
# If direct port 5432 is unreachable from your environment, you may use the
# pooler URL (port 6543) for both — Prisma Migrate works over the pooler when
# statement_cache_size=0 is set, with the caveat that DDL is per-statement.
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"

# --- Auth (JWT admin sessions) ---------------------------------------------
# MUST be set to a strong random string (>= 16 chars) in production.
# If unset in production, the app fails safe (no token is ever issued/trusted)
# and admin login is unavailable. Generate with: openssl rand -base64 48
JWT_SECRET="<replace-with-a-strong-random-secret>"

# --- Admin provisioning (one-time, optional) -------------------------------
# Used ONLY by the admin-provisioning script (bun run db:create-admin) to
# create the FIRST admin on a fresh database. Not read by the app at runtime.
# After the admin is created, these can be removed from the environment.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<replace-with-a-strong-password>"

# --- Public site URL (SEO, sitemap, canonical URLs) ------------------------
NEXT_PUBLIC_SITE_URL="https://your-production-domain.com"

# --- One-time data migration source (optional) ----------------------------
# Used ONLY by the data-migration script (bun run db:migrate-sqlite) to read
# the local SQLite source. Not used by the app at runtime.
SQLITE_SOURCE_URL="file:/home/z/my-project/db/custom.db"
